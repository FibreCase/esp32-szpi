menu "SZPI application"

config SZPI_WIFI_ENABLED
    bool "Enable Wi-Fi station"
    default y
    help
        Enable the configured 2.4 GHz Wi-Fi station service.

config SZPI_WIFI_PROVISION_TIMEOUT_S
    int "Provisioning session timeout (seconds)"
    range 60 600
    default 600
    depends on SZPI_WIFI_ENABLED

endmenu

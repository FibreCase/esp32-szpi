{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Simulator: Build and launch",
            "type": "shell",
            "command": "cmake -S simulator -B simulator/build && cmake --build simulator/build && ./simulator/build/szpi_ui_sim",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}

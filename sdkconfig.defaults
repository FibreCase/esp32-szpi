# JLC SZPI ESP32-S3: ESP32-S3-WROOM-1-N16R8.
CONFIG_IDF_TARGET="esp32s3"

# Optimize rendering and pixel conversion for speed; keep assertions enabled.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 16 MiB Quad SPI Flash, 80 MHz STR.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MiB Octal PSRAM, detected and initialized at boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Cache configuration for LVGL objects in PSRAM.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Two OTA application slots, no factory application.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# LVGL 9.5.0 is used directly; do not include upstream examples or demos.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n

# Explicit LVGL 9.5 memory and assertion configuration.
CONFIG_LV_USE_BUILTIN_MALLOC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=128
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"

# LCD ~60 Hz refresh target, with millisecond task scheduling.
CONFIG_SZPI_DISPLAY_SPI_CLOCK_HZ=80000000
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_FREERTOS_HZ=1000

# esp32-camera 2.1.8: borrow board-owned I2C_NUM_0 through SCCB's new driver.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
CONFIG_GC2145_SUPPORT=y
CONFIG_CAMERA_TASK_STACK_SIZE=4096
CONFIG_CAMERA_NO_AFFINITY=y
CONFIG_CAMERA_PSRAM_DMA=n

# Pin LVGL settings after migrating from older generated defaults.
# Keep style caching enabled for the high-refresh UI.
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_COLOR_MIX_ROUND_OFS=128
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_)}"
CONFIG_LV_USE_THEME_MONO=n

# First Wi-Fi setup: DPP Enrollee and LVGL QR code.
CONFIG_ESP_WIFI_DPP_SUPPORT=y
CONFIG_LV_USE_QRCODE=y
CONFIG_SZPI_WIFI_PROVISION_TIMEOUT_S=600

# Default event loop also dispatches DPP provisioning events.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
